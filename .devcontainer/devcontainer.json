{
    "name": "ForzaETH Race Stack Humble",
    "privileged": true,
    "remoteUser": "${localEnv:USER}",
    "updateRemoteUserUID": true,
    "image": "jet_forzaeth_racestack_ros2:humble",
    "build": {
        "dockerfile": ".devcontainer/Dockerfile.arm",
        "context": "..",
        "args": {
            "USERNAME": "${localEnv:USER}"
        }
    },
    "initializeCommand": "/bin/bash -c 'source ${localWorkspaceFolder}/.devcontainer/xauth_setup.sh'",
    "workspaceFolder": "/home/${localEnv:USER}/ws/src/racing_playground/",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/${localEnv:USER}/ws/src/racing_playground,type=bind",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "ms-vscode.cpptools-extension-pack",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "aaron-bond.better-comments",
                "eamodio.gitlens",
                "ms-iot.vscode-ros",
                "Github.copilot",
                "redhat.vscode-xml",
                "ms-python.autopep8",
                "xaver.clang-format",
                "cschlosser.doxdocgen",
                "foxundermoon.shell-format",
                "timonwong.shellcheck"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "XAUTHORITY": "/tmp/.Xauthority",
        "ROS_LOCALHOST_ONLY": "0",
        "ROS_DOMAIN_ID": "6",
        "USERNAME": "${localEnv:USER}",
        "RCUTILS_COLORIZED_OUTPUT": "1",
        "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
        "XDG_RUNTIME_DIR": "/tmp"
    },
    "runArgs": [
        "--name",
        "sim_x86_forzaeth_racestack_ros2_humble",
        "--net",
        "host",
        "--privileged",
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw"
    ],
    "mounts": [
        "source=/home/${localEnv:USER}/.Xauthority,target=/tmp/.Xauthority,type=bind,consistency=cached",
        "source=/dev,target=/dev,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/../cache/humble/build,target=/home/${localEnv:USER}/ws/build,type=bind",
        "source=${localWorkspaceFolder}/../cache/humble/install,target=/home/${localEnv:USER}/ws/install,type=bind",
        "source=${localWorkspaceFolder}/../cache/humble/log,target=/home/${localEnv:USER}/ws/log,type=bind"
    ],
    "postCreateCommand": "~/ws/src/racing_playground/.install_utils/post_create_command.sh"
}